FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300; // Initial guess

boundaryField
{
    east //BCs to be filled here
    {
        type            fixedValue; //type in bananas here to throw an error, see all available BC options
        value           uniform 300;
    }

    west
    {
        type            fixedValue;
        value           uniform 700;
    }
    
    "(front|back|north|south)"
    {
        type            empty;
    }

    fixedValueExample
    {
        type            fixedValue;
        value           uniform 100; // T value, K
    }

    convectionExample
    {
        type            mixed;
        Ta              298; // Ambient temperature, K
        h               10; // Convection coefficient, W/m2K
        k               15; // Thermal conductivity, W/mK
        dx              0.1; // Wall-normal mesh cell size, m

        refValue        uniform $Ta;
        refGradient     uniform 0;
        valueFraction   uniform #eval{ $h/($h + ($k/($dx/2))) };
    }

    fluxExample
    {
        type            fixedGradient;

        q               1000; // Flux, W/m2, positive=in, negative=out
        k               15; // Thermal conductivity, W/mK

        gradient        uniform #eval{ $q/$k };
    }

}

