FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    sides
    {
        type            inletOutlet;
        inletValue      uniform 0.0377336;
        value           uniform 0.0377336;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0;
        value           nonuniform List<scalar> 0;
    }
    inlet
    {
        type            inletOutlet;
        inletValue      uniform 0.0377336;
        value           uniform 0.0377336;
    }
    walls
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary1to2
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary1to3
    {
        type            processor;
        value           uniform 10;
    }
}


