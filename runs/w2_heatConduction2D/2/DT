    {
        type            empty;
    }
    south
    {
        type            calculated;
        value           uniform 4e-06;
    }
    east
    {
        type            calculated;
        value           uniform 4e-06;
    }
    north
    {
        type            calculated;
        value           uniform 4e-06;
    }
    west
    {
        type            calculated;
        value           uniform 4e-06;
    }
    front
    {
        type            empty;
    }
}


