FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300; // Initial guess

boundaryField
{
    east
    {
        type    fixedValue;
        value   uniform 300;
    }

    west
    {
        type    fixedValue;
        value   uniform 300;
    }

    north
    {
        type    fixedValue;
        value   uniform 650;
    }

    south{
        type    fixedValue;
        value   uniform 300;
    }
    
    "(front|back)"
    {
        type            empty;
    }

}

